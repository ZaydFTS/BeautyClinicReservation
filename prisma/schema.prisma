// Beauty Clinic Management System - Prisma Schema
// Laser Waxing Clinic - Full business management platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================================
// AUTHENTICATION
// ============================================================================

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("ADMIN") // ADMIN | SUPER_ADMIN
  telegramId   String?  // optional per-admin override
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions AdminSession[]
}

model AdminSession {
  id        String   @id @default(cuid())
  token     String   @unique
  adminId   String
  expiresAt DateTime
  createdAt DateTime @default(now())

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([token])
}

// ============================================================================
// SERVICES (laser waxing + other beauty treatments)
// ============================================================================

model Service {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Float
  durationMin Int      // duration in minutes
  category    String   @default("Waxing") // Waxing | Laser | Skincare | Other
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  slots       Slot[]
  appointments Appointment[]
}

// ============================================================================
// TIME SLOTS (admin-controlled availability)
// ============================================================================

model Slot {
  id         String   @id @default(cuid())
  serviceId  String
  startTime  DateTime // exact datetime when slot begins
  endTime    DateTime // exact datetime when slot ends
  capacity   Int      @default(1) // allow group bookings if needed
  status     String   @default("AVAILABLE") // AVAILABLE | BLOCKED | HOLIDAY
  note       String?  // e.g. "Lunch break", "Holiday"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  service       Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  appointments  Appointment[]

  @@index([serviceId])
  @@index([startTime])
  @@index([status])
}

// ============================================================================
// CUSTOMERS
// ============================================================================

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments Appointment[]
  orders       Order[]

  @@index([phone])
}

// ============================================================================
// APPOINTMENTS
// ============================================================================

model Appointment {
  id          String   @id @default(cuid())
  customerId  String
  serviceId   String
  slotId      String   @unique // one slot = one appointment (when capacity=1)
  status      String   @default("BOOKED") // BOOKED | COMPLETED | CANCELLED | NO_SHOW
  note        String?  // customer note
  price       Float    // snapshot of service price at booking time
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id])
  slot     Slot     @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([serviceId])
  @@index([status])
  @@index([slotId])
}

// ============================================================================
// PRODUCTS (e-commerce, no online payment)
// ============================================================================

model ProductCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  products Product[]
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Float
  cost        Float    @default(0) // for profit calc
  stock       Int      @default(0)
  lowStockAt  Int      @default(5) // alert threshold
  imageUrl    String?
  categoryId  String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category    ProductCategory? @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]

  @@index([categoryId])
  @@index([active])
}

// ============================================================================
// ORDERS (cash on delivery / pay in clinic)
// ============================================================================

model Order {
  id            String   @id @default(cuid())
  customerId    String?
  customerName  String   // snapshot - even guest checkout
  customerPhone String
  customerEmail String?
  address       String?
  notes         String?
  status        String   @default("PENDING") // PENDING | COMPLETED | CANCELLED
  paymentMethod String   @default("CASH_IN_CLINIC") // CASH_IN_CLINIC | COD
  subtotal      Float
  total         Float
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  customer Customer?  @relation(fields: [customerId], references: [id])
  items    OrderItem[]

  @@index([customerId])
  @@index([status])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String
  name      String  // snapshot
  price     Float   // snapshot
  quantity  Int
  total     Float

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

// ============================================================================
// FINANCIAL TRANSACTIONS (unified ledger - no FK constraints since refId
// may point to appointments OR orders OR products OR services)
// ============================================================================

model Transaction {
  id          String   @id @default(cuid())
  type        String   // APPOINTMENT | ORDER | PRODUCT | SERVICE
  amount      Float
  status      String   @default("PENDING") // PENDING | COMPLETED | CANCELLED
  refId       String?  // appointmentId | orderId | productId | serviceId
  refKind     String?  // for clarity: "Appointment" | "Order" | "Product" | "Service"
  description String?
  customerId  String?
  createdAt   DateTime @default(now())

  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@index([customerId])
}

// ============================================================================
// NOTIFICATIONS LOG (admin-only notifications sent)
// ============================================================================

model NotificationLog {
  id        String   @id @default(cuid())
  channel   String   // TELEGRAM | WHATSAPP
  to        String
  subject   String
  message   String
  status    String   @default("SENT") // SENT | FAILED
  error     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ============================================================================
// SETTINGS (clinic-wide config)
// ============================================================================

model ClinicSetting {
  id              String   @id @default(cuid())
  key             String   @unique
  value           String
  updatedAt       DateTime @updatedAt
}
